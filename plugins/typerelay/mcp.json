{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "typerelay": {
      "type": "streamable-http",
      "url": "https://mcp.typerelay.com/mcp/app",
      "extensions": {
        "com.openai": {
          "auth": {
            "type": "oauth",
            "client": {
              "mode": "dcr"
            },
            "resource": "https://mcp.typerelay.com/mcp/app",
            "baseScopes": [
              "content:read"
            ],
            "defaultScopes": [
              "content:read",
              "content:write",
              "sharing:write",
              "trash:purge"
            ],
            "oidcEnabled": false
          }
        }
      }
    }
  }
}
